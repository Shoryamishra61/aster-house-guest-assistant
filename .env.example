# Aster House Hotel Guest Assistant Configuration

# LLM mode: "mock" (default for zero-key evaluation) or "real"
LLM_MODE=mock
MOCK_LLM=true

# Real provider configuration (used only when LLM_MODE=real)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1

# Timeouts and session limits
LLM_TIMEOUT_MS=6000
SESSION_TTL_MINUTES=60
MAX_MESSAGE_LENGTH=2000

# Logging
LOG_LEVEL=info
